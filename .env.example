PORT=3000

DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379

# real providers
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# mock provider for failover demo (see mock-provider/)
MOCK_PROVIDER_URL=http://localhost:4000

# admin: required for /metrics; leave unset to deny access
ADMIN_API_KEY=

# optional bootstrap: set a raw key and the gateway creates the client on
# first boot (no SQL needed) — rotate after first use
SEED_CLIENT_KEY=
SEED_CLIENT_NAME=seed-client
SEED_BUCKET_SIZE=20
SEED_REFILL_RATE=5

# rate limiter: true = admit traffic during a redis outage (default),
# false = reject with 503 instead
RATE_LIMIT_FAIL_OPEN=true

# clamp for client-supplied max_tokens
MAX_TOKENS=8192

# request_log retention: 0 disables pruning
LOG_RETENTION_DAYS=30
METRICS_WINDOW_DAYS=30

# auth brute-force throttle
AUTH_MAX_FAILURES=5
AUTH_FAIL_WINDOW_SECONDS=60

# circuit breaker tuning
CB_FAILURE_THRESHOLD=3
CB_WINDOW_SECONDS=30
CB_COOLDOWN_SECONDS=60

# rate limiter (token bucket defaults, overridden per api_client row)
DEFAULT_BUCKET_SIZE=20
DEFAULT_REFILL_RATE=5